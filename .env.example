# Root Environment Variables Template

# Backend Database Settings
DB_HOST=localhost
DB_PORT=3306
DB_NAME=monitoring_alert_system
DB_USER=root
DB_PASSWORD=your_mysql_password

# JWT & Security
JWT_SECRET_KEY=your_super_secret_jwt_key_here
